*{box-sizing:border-box}body{margin:0;background:#08110b;color:#eaf4d8;font-family:Arial,sans-serif;overflow:hidden}canvas{position:fixed;inset:0;width:100%;height:100%;background:#19351d}.panel,.modal{background:#0c1710eF;border:1px solid #8e7339;border-radius:13px;padding:28px;box-shadow:0 18px 70px #0009}.panel{position:fixed;left:50%;top:50%;transform:translate(-50%,-50%);text-align:center;width:min(410px,90vw)}h1{font-size:36px;margin:0;color:#b99343;letter-spacing:2px}h1 b{color:#df4a29}input,select,button{display:block;width:100%;margin:12px 0;padding:13px;border-radius:7px;border:1px solid #79835f;background:#172419;color:#fff;font-weight:bold}button{cursor:pointer;background:#ba4a2c;border-color:#f59c52}button:hover{filter:brightness(1.2)}small{color:#aab8a0}.hidden{display:none!important}.overlay{position:fixed;inset:0;background:#000a;z-index:5;display:grid;place-items:center}.modal{width:min(900px,94vw);text-align:center}.modal h2{color:#e3b956}.modal p{color:#c9d6be}.cards{display:flex;gap:13px;justify-content:center;flex-wrap:wrap}.card{width:230px;text-align:left;min-height:140px;border:2px solid #89928a;background:#222b22}.card h3{margin:0 0 10px}.card small{display:block}.card.common{border-color:#aaa}.card.uncommon{border-color:#42b86a}.card.rare{border-color:#4c96ed}.card.epic{border-color:#ae59d2}.card.legendary{border-color:#f1a132}.card.cursed{border-color:#cb3030;background:#280d10}#hud{position:fixed;inset:0;pointer-events:none;text-shadow:0 2px 2px #000}#top{display:flex;justify-content:space-between;padding:16px;font-weight:bold}#stats{position:absolute;left:18px;bottom:20px;width:310px}.bar{height:20px;background:#111;border:2px solid #ddd;border-radius:12px;position:relative;margin:7px 0;overflow:hidden}.bar i{display:block;height:100%;width:100%;background:#d3443b;transition:.15s}.xp i{background:#e2bc36}.bar label{position:absolute;inset:1px;text-align:center;font-size:12px;font-weight:bold}#skills{position:absolute;right:15px;bottom:15px;display:flex;gap:8px}.skill{background:#111c;border:1px solid #b99343;width:118px;padding:8px;font-size:12px}.skill b{display:block;color:#eac35b}.skill.cool{opacity:.55}#feed{position:absolute;right:16px;top:55px;text-align:right;color:#f3d378}
